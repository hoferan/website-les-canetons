RewriteEngine on

# ---------------------------------------------------------------------------
# Laravel API dispatch.
#
#   /api/*     -> the Laravel app in _api/
#   /sanctum/* -> ditto. Sanctum's SPA flow needs GET /sanctum/csrf-cookie,
#                 which is not under /api/.
#
# This block MUST stay above the SPA fallback below. Both are mod_rewrite
# rules evaluated in the same phase, in textual order, and that fallback
# matches every path (^) — so if it ran first every /api/* and /sanctum/*
# request would be handed to the SPA shell and this dispatch would never happen
# at all. Nothing can usefully be ordered after a catch-all, which is why the
# fallback comes last and everything that needs to claim a path first, this
# block included, comes before it.
#
# Three RedirectMatch 301 legacy-URL rules used to sit between the two, and
# were deleted on 2026-09-07. Their textual position was never what mattered:
# a RedirectMatch is mod_alias, whose hooks are ordered against mod_rewrite's
# by module load order rather than by position in an .htaccess. What actually
# bit was the re-entry interaction — see the block that replaced them for the
# mechanism, which is worth reading before adding any redirect here.
#
# The Laravel project sits at _api/ in the document root — see tools/build.mjs,
# which picks that name. The substitution below must not match its own output,
# because in per-directory context it re-enters the whole ruleset. It cannot:
# ^api(/|$) matches only a path that is EXACTLY `api` or that BEGINS `api/`, so
# _api/public/index.php does not match — and neither would any name but the
# literal `api` itself. That is the one rename that needs a REDIRECT_STATUS
# guard added to both dispatch rules first; every other name is loop-safe for
# free. (The previous name, api-laravel, was safe for exactly this reason too.
# The comment here used to credit the hyphen for defeating (/|$), which is true
# but narrower than the rule that actually protects this.)
# ---------------------------------------------------------------------------

# Forward the Authorization and X-XSRF-Token headers into the request
# environment BEFORE the dispatch rules below terminate the current rewrite
# pass. Laravel ships equivalent rules in its stock public/.htaccess, and the
# reason they cannot be relied on is simply that they are no longer there:
# _api/public/.htaccess IS read on the re-entered pass — per-directory rules in
# the resolved file's own directory do get evaluated, and Laravel's
# header-forwarding rules are unguarded `RewriteRule .* - [E=...]`, so they
# would match and fire — but that whole rewrite block was deleted from the file
# on 2026-09-07. It now carries an authorization grant and nothing else,
# re-opening the one directory of the Laravel tree that _api/.htaccess's
# deny-all closes. So the header forwarding has to happen here.
#
# Deleting that block cost nothing, which is a separate point about a separate
# rule: Laravel's FRONT-CONTROLLER rule is guarded `RewriteCond
# %{REQUEST_FILENAME} !-f`, and the dispatch below names public/index.php
# outright, so by the re-entered pass the request filename IS an existing file
# and the guard fails. That rule had nothing left to route either way.
# (Both files do now ship to every server: the deploy CLI's protected set is
# root-relative paths, not basenames at any depth.)
# CGI-family SAPIs — which is what this host and the local container both use —
# do not hand Authorization to PHP otherwise. The X-XSRF-Token rule is the same
# belt-and-braces Laravel ships; it is kept so this block stays a faithful
# stand-in for the rules Laravel's own stock public/.htaccess carries
# upstream, even though Apache already exports
# arbitrary request headers as HTTP_* (X-XSRF-Token reaches PHP without this
# rule) and the E= value this rule sets arrives on the dispatched request as
# REDIRECT_HTTP_X_XSRF_TOKEN, which Symfony's ServerBag doesn't read (its
# REDIRECT_ fallback exists only for REDIRECT_HTTP_AUTHORIZATION) — so the
# rule is inert for X-XSRF-Token specifically; cookie-based Sanctum SPA CSRF
# (which GET /sanctum/csrf-cookie exists to seed) works anyway, via the header
# Apache regenerates natively.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^(api|sanctum)(/|$) - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTP:x-xsrf-token} .
RewriteRule ^(api|sanctum)(/|$) - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

# [L], NOT the tidier END flag — do not "modernise" this back.
#
# In per-directory context a substitution is handed back to the URL-parsing
# engine as an internal redirect and the whole ruleset runs again against the
# new path, so [L] ends only the CURRENT pass, not rewrite processing overall;
# the END flag stops that outright and would make this dispatch a single
# unconditional hop. But that flag was added in Apache 2.3.9 and does not
# exist in 2.2; this shared host's version is unresolved (staging/README.md
# records that it 500s on <RequireAny>, which leans 2.2); an unknown
# RewriteRule flag is a syntax error — a 500 on EVERY request to the whole
# site, public pages included — and no <IfModule> can guard a RewriteRule
# flag. [L] is valid on both 2.2 and 2.4, so it is the only safe choice.
#
# [L] is correct here, not merely safe, and was verified empirically (Laravel
# still answers its own 401 with it): on the second pass the path is
# _api/public/index.php, which ^api(/|$) cannot match (see the note above),
# and REDIRECT_STATUS is set by then, so the SPA fallback below
# does not match either. Hence no rewrite loop. Depending on REDIRECT_STATUS is
# not a new liability: the fallback below already relies on it on this FastCGI
# host.
RewriteRule ^api(/|$) _api/public/index.php [L]
RewriteRule ^sanctum(/|$) _api/public/index.php [L]

# ---------------------------------------------------------------------------
# There are deliberately NO legacy URL redirects here.
#
# Three RedirectMatch 301 rules lived at this point until 2026-09-07, mapping
# the pre-SPA site's /x.php and /x.html URLs onto today's clean ones. They were
# removed because their targets no longer exist: the rebuild makes every URL
# English (design D10) and owes no backwards compatibility (D11), so
# /historique.php would have 301'd to /historique and then answered the SPA's
# own 404 view — one extra hop to the same place.
#
# They also carried both of this file's negative-lookahead landmines, and each
# had already broken something: the .php rule's lookahead excluding the
# dispatch target directory (with its `.*` prefix missing, EVERY /api/* request
# 301s and the whole API is down while every page still renders — only
# reproducible on the real host, whose FastCGI wrapper prefixes
# /cgi-bin/php5.fcgi/ onto the re-entered path) and the .html rule's
# `(?!index\.html$)` (without it the fallback's own output is 301'd and every
# URL redirect-loops).
#
# If a redirect is ever needed again, note what made these dangerous: a
# RedirectMatch is mod_alias, which runs on the re-entered pass after
# mod_rewrite's substitution, so it sees INTERNAL paths — including whatever
# prefix this host's PHP wrapper adds. Anchor on the full path, exclude the
# dispatch target with a `.*`-prefixed lookahead, and add a case to
# tools/build-overlays.test.mjs asserting the fcgi-prefixed form.
# ---------------------------------------------------------------------------

# SPA fallback: every request is served the shell, index.html, EXCEPT real
# static assets under /assets/ (the hashed bundles Vite emits, plus img/ and
# icons/ copied verbatim), which are served directly. React Router then decides
# what to render from the URL — see web/src/routes.tsx.
#
# An unknown URL therefore answers 200 with the SPA's own 404 view rather than a
# real 404. Accepted deliberately: the alternative is enumerating every route
# here, where it would drift from the router.
#
# The catch-all is also a second layer in front of the Laravel tree — no longer
# the only one, and no longer the primary one. _api/.htaccess's deny-all now
# ships to every server, and it is strictly stronger: Apache evaluates
# authorization during its directory walk, BEFORE mod_rewrite's per-directory
# rules run in the fixup phase, so a request for _api/.env is refused with a
# real 403 and this rewrite never sees it. What the catch-all still adds is
# coverage of anything outside the Laravel tree, where that deny-all does not
# reach — the now-dead config.php still sitting on each server, and any future
# stray file — plus the 200-with-the-SPA's-own-404-view behaviour described
# above, which is why a retired path like /api-laravel/.env answers the shell
# rather than a 404.
#
# Two properties are load-bearing and must survive any edit:
#
#  1. The REDIRECT_STATUS guard is essential on FastCGI hosts (e.g.
#     easy-hebergement, php-cgi/FPM): once Apache has internally rewritten a
#     request to index.html it sets REDIRECT_STATUS, so the rule does NOT match
#     a second time. Without it the rewrite re-matches its own output and loops
#     until Apache aborts with 500 ("Request exceeded the limit of 10 internal
#     redirects") — on EVERY url of the site, not just one page.
#  2. It stays a CATCH-ALL rather than an !-f/!-d guard. A !-f guard serves
#     whatever exists, which is the opposite of what is wanted for files that do
#     exist and must not be read — config.php still being the live example. It
#     is no longer the only thing standing in front of _api/.env and
#     _api/vendor/ (_api/.htaccess's deny-all is), so this is no longer the sole
#     reason the Laravel tree is safe — but it is still what makes an unknown
#     URL answer the SPA instead of whatever happens to be on disk.
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^ index.html [L]

# This host has no MIME mapping for woff2, so it served the fonts as
# text/plain until this was added (observed on TEST, 2026-08-31). Browsers
# sniff font data and render them anyway, which is exactly why it went
# unnoticed — but a wrong Content-Type is the sort of thing a proxy or a
# future browser policy stops tolerating. woff/woff2 are the IANA-registered
# types (RFC 8081), not the old x-font-* forms.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Cache policy for this site.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Vite's build output is content-hashed: a given
  # filename's bytes never change, only the filename does when the
  # content does. Safe to cache indefinitely instead of revalidating.
  #
  # FONTS BELONG HERE TOO, and were missing until 2026-08-31. Vite hashes
  # them exactly like the JS and CSS (lilita-one-latin-400-normal-87r-Z-Re.woff2),
  # so they are just as safe to freeze — but matching neither this block nor
  # the image block below, they came back from the server with NO
  # Cache-Control at all. Browsers then fall back to heuristic freshness,
  # which is unpredictable and generally costs a revalidation round trip per
  # font. Four fonts, on a members' area that is read every week on a phone
  # outdoors, is worth the two characters.
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Images change rarely; let them cache for a day to stay fast. Bump the file
# name (or clear this rule) if you ever need an image to update immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|ico|webp)$">
    ExpiresDefault "access plus 1 day"
  </FilesMatch>
</IfModule>
