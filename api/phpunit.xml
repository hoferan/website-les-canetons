<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- The SESSION COOKIE'S NAME comes from here, and that is the whole
             reason this is pinned. config/session.php derives it as
             `Str::slug(APP_NAME).'-session'`, so every environment that has an
             .env answers `les-canetons-api-session` and one that has none
             answers Laravel's default `laravel-session`.

             CI has no .env. So ResponseHygieneTest::
             test_the_document_names_the_cookie_the_api_actually_sets compared
             the committed document — exported in Docker, where APP_NAME is set
             — against a name no server ever uses, and failed on the runner
             while passing everywhere a developer could see. It had been failing
             since the document gained that security scheme; nothing noticed,
             because no pull request had been opened in between.

             Same class as SESSION_SECURE_COOKIE and AUTO_MIGRATE below, one
             environment further out: the suite must measure what ships, not
             what the ambient environment happens to provide. -->
        <env name="APP_NAME" value="Les Canetons API"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- THE HASHING WORK FACTOR, and the only pin in this file that buys
             speed rather than correctness.

             BCRYPT_ROUNDS below tunes a hasher this application does not use.
             config/hashing.php defaults the driver to argon2id and keeps
             bcrypt only as the documented fallback for a host built without
             argon2 support, so that pin never reached the code under test and
             the suite hashed at the full production work factor: 64 MiB and
             four passes, measured at 177 ms per hash on a web-session
             container. Every test that builds a Member through the factory
             paid it once per member. That was ~120 of the suite's 147 seconds
             (measured 2026-09-18); DevSeederTest creates six members and spent
             990 ms doing nothing else. At 8 MiB and one pass a hash costs
             6 ms and the whole suite runs in 31 s, all 636 tests green.

             Same shape as AUTO_MIGRATE and SESSION_SECURE_COOKIE below: the
             value is pinned because the ambient environment supplies another
             one. api/.env.example and docker/api/env.docker both ship
             ARGON_MEMORY=65536 and ARGON_TIME=4, and those are the numbers
             that protect real members — they are deliberately left alone.

             WHAT THIS GIVES UP, said plainly because every other pin here
             exists to stop the suite measuring something other than what
             ships: the work factor is now the one hashing property the suite
             does NOT measure at production strength. That is affordable only
             because nothing asserts it — HashingTest pins the DRIVER and the
             `$argon2id$` prefix, never the cost. A test that ever cares what
             hashing COSTS must set its own parameters rather than lean on
             these. -->
        <env name="ARGON_MEMORY" value="8192"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- database, not array: the login throttle (AuthController) runs on
             the RateLimiter, which is cache-backed. The array store is
             per-process, so it would let a throttled attempt through on a real
             multi-worker server while the suite stayed green. -->
        <env name="CACHE_STORE" value="database"/>
        <!-- Tests run against a real MariaDB (matches prod): the migrations use
             MariaDB-specific features (enum, char, raw ALTER TABLE for the
             used_challenges PK swap) that SQLite can't reproduce. laravel_api_test
             is a dedicated database, isolated from the old app's lescanetons_test.
             canetons/canetons are the same synthetic local-dev credentials the
             project already commits in config/config.docker.php. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <!-- `db`, the compose service name: the suite runs INSIDE the web
             container, where the database is not on loopback. 127.0.0.1 was
             correct only for the retired two-container stack. -->
        <env name="DB_HOST" value="db"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="laravel_api_test"/>
        <env name="DB_USERNAME" value="canetons"/>
        <env name="DB_PASSWORD" value="canetons"/>
        <!-- Sanctum only starts a session (which login/logout need) for requests
             it recognises as coming from a stateful frontend, matching the
             Origin host against this list. Tests send `Origin: http://localhost`
             with no port, so pin the bare host here rather than inheriting
             docker/api/env.docker's deliberately port-qualified
             localhost:8090,127.0.0.1:8090 — which does not match and leaves the
             request session-less (500: "Session store not set on request"). -->
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost"/>
        <!-- OFF here, though config/app.php defaults it ON — the suite must
             never migrate implicitly. Two reasons, either sufficient:
             MigrateTest deliberately leaves a probe migration PENDING to prove
             `mode=dry-run` applies nothing, and RunPendingMigrations sitting in
             front of that request would apply it first and make the assertion
             fail; and more generally a test that silently repaired the schema
             underneath itself would hide exactly the breakage a suite is for.
             AutoMigrateTest turns it back on with config([...]) per test, the
             same way MigrateTest (named above) sets app.migrate_token in each
             of its own. Pinned rather than left to the ambient environment
             because the suite runs INSIDE the web container, where
             docker/api/env.docker is mounted as _api/.env with
             AUTO_MIGRATE=true. -->
        <env name="AUTO_MIGRATE" value="false"/>
        <!--
            The bootstrap administrator must NOT be created during the suite.
            docker/api/env.docker sets these so the local stack can bootstrap
            itself, and without pinning them here every test's RefreshDatabase
            migration would create comite.local — which holds members.manage,
            so AccessIntegrityTest's "last administrator" fixtures stop being
            the last administrator and BootstrapAdministratorTest starts from a
            bootstrapped database.

            Empty, not absent: `blank()` is what the migration checks, and an
            explicit empty value is immune to whatever a container or a
            developer's shell happens to export. Same reasoning as
            SESSION_SECURE_COOKIE below, which was pinned after two tests were
            green natively and red in Docker for a day.
        -->
        <env name="BOOTSTRAP_ADMIN_USERNAME" value=""/>
        <env name="BOOTSTRAP_ADMIN_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- The two mail addresses, pinned because api/.env.example ships both
             as CHANGE_ME and a generated web-session .env keeps them: left to
             the environment, rendering a mailable throws "Email CHANGE_ME does
             not comply with addr-spec of RFC 2822" on one machine and passes on
             another.

             They differ here for the reason config/mail.php gives. The mailbox
             the site sends AS is not the one the committee reads, and a suite
             that set both to the same value could not tell them apart.
        -->
        <env name="MAIL_FROM_ADDRESS" value="noreply@example.test"/>
        <env name="MAIL_COMMITTEE_ADDRESS" value="comite@example.test"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- The DEPLOYED posture, pinned for the same reason as AUTO_MIGRATE
             above: the suite runs INSIDE the web container, where
             docker/api/env.docker is mounted as _api/.env and sets
             SESSION_SECURE_COOKIE=false. That override is correct for local dev
             — :8090 is plain http, and a browser will not send a Secure-only
             cookie back over it, so login breaks outright without it — but a
             suite that inherits it is measuring a dev workaround instead of
             what ships. Left unpinned, SessionLifetimeTest's two cookie tests
             fail in Docker while passing natively in a Claude Code web session,
             where api/.env comes from api/.env.example and omits the variable
             altogether. They did exactly that.
             The fallback this pin hides — what a server gets when its .env says
             nothing — is asserted by
             SessionLifetimeTest::test_the_secure_cookie_default_is_true_when_a_server_sets_nothing,
             which clears the variable and re-reads config/session.php. -->
        <env name="SESSION_SECURE_COOKIE" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
