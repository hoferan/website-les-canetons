<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- database, not array: the login throttle (AuthController) runs on
             the RateLimiter, which is cache-backed. The array store is
             per-process, so it would let a throttled attempt through on a real
             multi-worker server while the suite stayed green. -->
        <env name="CACHE_STORE" value="database"/>
        <!-- Tests run against a real MariaDB (matches prod): the migrations use
             MariaDB-specific features (enum, char, raw ALTER TABLE for the
             used_challenges PK swap) that SQLite can't reproduce. laravel_api_test
             is a dedicated database, isolated from the old app's lescanetons_test.
             canetons/canetons are the same synthetic local-dev credentials the
             project already commits in config/config.docker.php. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <!-- `db`, the compose service name: the suite runs INSIDE the web
             container, where the database is not on loopback. 127.0.0.1 was
             correct only for the retired two-container stack. -->
        <env name="DB_HOST" value="db"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="laravel_api_test"/>
        <env name="DB_USERNAME" value="canetons"/>
        <env name="DB_PASSWORD" value="canetons"/>
        <!-- Sanctum only starts a session (which login/logout need) for requests
             it recognises as coming from a stateful frontend, matching the
             Origin host against this list. Tests send `Origin: http://localhost`
             with no port, so pin the bare host here rather than inheriting
             docker/api/env.docker's deliberately port-qualified
             localhost:8090,127.0.0.1:8090 — which does not match and leaves the
             request session-less (500: "Session store not set on request"). -->
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost"/>
        <!-- OFF here, though config/app.php defaults it ON — the suite must
             never migrate implicitly. Two reasons, either sufficient:
             MigrateTest deliberately leaves a probe migration PENDING to prove
             `mode=dry-run` applies nothing, and RunPendingMigrations sitting in
             front of that request would apply it first and make the assertion
             fail; and more generally a test that silently repaired the schema
             underneath itself would hide exactly the breakage a suite is for.
             AutoMigrateTest turns it back on with config([...]) per test, the
             same way SouperSignupFlagTest does. Pinned rather than left to the
             ambient environment because the suite runs INSIDE the web
             container, where docker/api/env.docker is mounted as
             api-laravel/.env with AUTO_MIGRATE=true. -->
        <env name="AUTO_MIGRATE" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
