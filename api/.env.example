# Laravel's server-side configuration — the SERVER-OWNED half of the API.
#
# Same operational pattern as the old app's config.php: never built into the
# deploy artifact (tools/build.mjs strips .env), never uploaded, never deleted
# by a deploy (tools/deploy/preflight.mjs treats `.env` as protected at any
# depth). You place it once per server, by hand:
#
#   1. copy this file to the server as   <docroot>/api-laravel/.env
#   2. fill in every CHANGE_ME below
#   3. generate APP_KEY (see APP_KEY)
#   4. re-check it after any deploy that adds a key here
#
# Without it Laravel cannot boot: the first dispatched /api/* request fails
# outright ("No application encryption key has been specified"), which on a
# server with APP_DEBUG=false is an opaque 500.
#
# Local Docker dev does NOT use this file — docker/api/env.docker is mounted
# over api-laravel/.env in the web container. This is the documented shape both
# follow.
#
# Every key below is read by api/config/*.php. Keys the framework supports but
# this app has no use for (Redis, S3, queues beyond `sync`, Memcached, …) are
# deliberately absent — their defaults are correct, and listing them would
# invite someone to "configure" infrastructure that does not exist.

# --- Application -------------------------------------------------------------
# Seeds the session cookie name and the cache key prefix (config/session.php,
# config/cache.php).
APP_NAME="Les Canetons API"

# NOT cosmetic. POST /api/migrate reports this back in its JSON `environment`
# key and `npm run dbmigrate:<env>` prints the whole body, so a server left on
# Laravel's default ('production') logs "environment: production" in the middle
# of a QA migration — exactly the reassurance you would want to be able to
# trust. Use: test | qa | production
APP_ENV=CHANGE_ME

# Encrypts the session cookie payload and everything else Laravel encrypts.
# Generate ONE PER SERVER — never reuse another environment's, and never the
# public one in docker/api/env.docker. On the server:
#     php api-laravel/artisan key:generate --show
# and paste the whole "base64:…" string here. Rotating it logs everyone out.
APP_KEY=

# MUST be false on every server. True leaks stack traces, the .env contents and
# the DB credentials to anyone who triggers an error.
APP_DEBUG=false

# The site's public base URL, scheme included, no trailing slash — e.g.
# https://test.lescanetons.org. Used for absolute URL generation and, via
# config/mail.php, as the SMTP EHLO domain.
APP_URL=https://CHANGE_ME

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Cost factor for bcrypt password hashing (the User model's 'hashed' cast).
BCRYPT_ROUNDS=12

# Laravel writes to api-laravel/storage/logs/, which must be writable by the
# web user. `error` (not `debug`) on a server: `debug` logs every query and
# fills a shared host's disk.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- Database ----------------------------------------------------------------
# The SAME MariaDB database the old app's config.php points at — this project
# shares that one connection and gets no database of its own. Copy the values
# straight out of the server's config.php `db` block.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- Sessions & Sanctum ------------------------------------------------------
# Auth is Sanctum's SPA cookie-session mode (same origin, no API tokens, no
# CORS). `database` keeps sessions in the shared `sessions` table, so they
# survive across FPM processes.
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Leave EMPTY (host-only cookie) unless the site is genuinely served across
# subdomains. Setting a domain makes the cookie apply to every *.that-domain
# name, and getting it wrong silently breaks login with no error anywhere.
SESSION_DOMAIN=

# Comma-separated hosts (NO scheme) that Sanctum treats as a stateful frontend.
# Must be the exact host the browser sends — a mismatch does not error, it just
# leaves cookie-authed /api/* calls out of stateful mode and 401s them with no
# obvious cause. Single-origin site => the site's own hostname, e.g.
# test.lescanetons.org
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME

# --- Cache -------------------------------------------------------------------
# MUST be `database`. App\Support\ChallengeGuard uses the cache as the
# single-use store behind the Altcha replay guard: `array` is per-process and
# `file` is per-server, so on either one every replay would succeed — while
# every test stayed green. SignupController::verifyChallenge() refuses outright
# on anything other than database/redis/memcached, so a wrong value here turns
# every signup into a 403 rather than silently dropping the protection.
CACHE_STORE=database

# No background work — mail is sent inline during the request.
QUEUE_CONNECTION=sync

# --- Mail (contact form + signup confirmations) -------------------------------
# Authenticated SMTP on easy-hebergement. Create a real, ACTIVE mailbox (a
# "boîte mail" — NOT an alias, which cannot send). The ports are NON-STANDARD:
#   MAIL_SCHEME=smtps  => MAIL_PORT=465   (recommended; this is the old
#                                          config.php's secure => 'ssl')
#   MAIL_SCHEME=smtp   => MAIL_PORT=4650  (STARTTLS — NOT 587, which is plain
#                                          text on this host)
# Set MAIL_SCHEME explicitly. Left unset, Symfony infers TLS from the port, and
# these ports are not the ones it would infer from.
# MAIL_HOST is mail-a OR mail-b.easy-hebergement.net — whichever that
# messagerie's detail page shows; it varies per mailbox.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail-a.easy-hebergement.net
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME="${APP_NAME}"

# --- Secrets -----------------------------------------------------------------
# Shared secret gating POST /api/migrate. Must match MIGRATE_TOKEN in the
# .env.<env> of whatever machine runs `npm run dbmigrate:<env>` (and the env's
# CI secret). Any long random string, one per server. Unset here => the endpoint
# answers 403 to everything, so every post-deploy migration fails.
MIGRATE_TOKEN=CHANGE_ME

# HMAC key signing the self-hosted Altcha proof-of-work challenges
# (GET /api/altcha) that POST /api/signups then verifies. REQUIRED: both
# endpoints fail closed on an empty value or the literal CHANGE_ME —
# /api/altcha answers 503 and every signup answers 403 `captcha_failed`, which
# reads as a broken form rather than a missing setting. Any long random string,
# one per server; never the public one in docker/api/env.docker, which anyone
# reading the repo could forge challenges with.
ALTCHA_HMAC_SECRET=CHANGE_ME
