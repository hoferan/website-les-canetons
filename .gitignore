# Repository ignores for the WordPress rebuild.
#
# Scope note: this repository tracks ONLY our own theme and plugin. WordPress
# core, third-party plugins, wp-config.php and uploads/ are server-owned and
# never tracked — see
# docs/superpowers/specs/2026-07-28-wordpress-migration-design.md §10. Which
# versions run alongside our code is recorded in
# docs/wordpress-install-manifest.csv.
#
# Rules scoped to wp-content/ and to the plugin live in their own nested
# .gitignore files, so they travel with the directories they describe.

# --- secrets and per-server configuration ----------------------------------
# Deploy credentials, one file per environment.
.env
/.env.*
!/.env.example

# WordPress writes real database credentials and salts here.
wp-config.php

# HTTP Basic Auth credential files (hashed, but still secrets — brute-forcible
# offline, and they expose usernames). TEST sits behind Basic Auth (spec §8).
.htpasswd

# --- real data — never commit ----------------------------------------------
# Includes the archived signups / contact_messages export (spec §7): real
# member and guest personal data, kept outside the web root, never in git.
*.sql
*.sql.gz
*.dump.sql
prod-*.sql

# --- dependencies and caches (dev-only; never deployed) ---------------------
/node_modules/
vendor/
.phpcs.cache
.phpunit.cache
.phpunit.result.cache

# --- local scratch ----------------------------------------------------------
.superpowers
.tmp

# --- Claude Code ------------------------------------------------------------
# per-machine Claude Code settings (the tracked .claude/settings.json holds the
# team-wide hooks; this file is personal overrides only)
/.claude/settings.local.json

# --- OS / editor junk -------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
