# secrets & local-only
config.php
.env
/.env.*
!/.env.example
.superpowers
.tmp
/public/

# HTTP Basic Auth credential files (hashed, but still secrets — brute-forcible
# offline; usernames exposed). The .htaccess that references them IS tracked.
# See staging/README.md for how to (re)generate these.
.htpasswd

# real prod data — never commit (use the synthetic Docker seed instead)
*.dump.sql
prod-*.sql

# dependencies (dev-only tooling; never deployed)
/node_modules/
/vendor/

# Persistent Composer download cache reused across builds (tools/build.mjs)
/.composer-cache/

# Laravel API (api/) — dependencies & generated runtime artifacts. api/ ships
# its own .gitignore too (Composer vendor/, .env, storage/framework caches,
# bootstrap/cache, logs); these root-level entries are belt-and-suspenders so
# nothing generated under api/ is ever tracked from the repo root.
/api/vendor/
/api/node_modules/
# Laravel's real configuration, per developer. ALSO an empty stub Docker
# creates: docker-compose.yml mounts docker/api/env.docker onto
# /var/www/html/_api/.env, which nests inside the ./api -> _api mount and
# writes through to a 0-byte api/.env on the host. Harmless to the container,
# but note the stub SILENTLY SHADOWS a real .env for host-side `php artisan`
# use under api/ — Laravel finds a (useless) .env already present instead of
# none.
/api/.env
/api/public/build/
/api/public/hot
/api/storage/*.key
/api/.phpunit.result.cache

# Laravel scaffold files this API-only project does NOT use — `composer
# create-project laravel/laravel` regenerates these, but they're dead weight
# here (no Blade/Vite frontend; GitHub ignores nested workflow dirs; StyleCI
# unused). Ignored so a future re-scaffold + `git add` can't re-track them.
/api/package.json
/api/package-lock.json
/api/vite.config.js
/api/.styleci.yml
/api/.npmrc
/api/.github/

# generated FTP deploy artifact (npm run build); never hand-edit or commit
/dist/build/

# generated per-env overlay files (npm run build:overlay); never hand-edit or commit
/dist/

# Playwright run output (npm run test:e2e): traces, screenshots and the HTML
# report. Regenerated on every run; never committed.
/test-results/
/playwright-report/
/blob-report/

# linter / tool caches
.php-cs-fixer.cache
.phpcs.cache
.phpunit.cache
.phpunit.result.cache

# The preview server's configuration, tracked ON PURPOSE and against a global
# ignore. `**/.claude/launch.json` is excluded in ~/.config/git/ignore, next to
# settings.local.json, because that file is usually machine-specific. This one
# is not: it holds a port this project cannot change (see docs/traps.md) and
# an instruction to ATTACH rather than start, which is right on every machine.
#
# A repo .gitignore outranks core.excludesFile, so this negation is what makes
# it trackable. Without it every fresh clone starts with no launch config, and
# whatever writes one guesses `npm run dev` — which here is `docker compose up`,
# not a dev server, and starting it a second time fights the first for five
# ports.
!.claude/launch.json

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.idea/
