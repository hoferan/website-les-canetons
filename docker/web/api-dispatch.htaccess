# ---------------------------------------------------------------------------
# Laravel API dispatch.
#
# Local-dev only for now: tools/build-overlays.mjs merges this block onto
# app/.htaccess to produce the local Docker document root's .htaccess. Shipping
# it to a real server is sub-project 2a-ii's job for the contact/signups/altcha
# endpoints, and sub-project 2b's job for events/responses — today those five
# live endpoints are still served by the old app, so dispatching them into
# Laravel before it implements them would 404 all five. ^api(/|$) is
# all-or-nothing, so this block can't move until BOTH sub-projects have
# landed — moving it after only one would 404 whichever pair still lives in
# the old app. Once both have landed, this block moves into app/.htaccess
# unchanged.
#
#   /api/*     -> the Laravel app in api-laravel/
#   /sanctum/* -> ditto. Sanctum's SPA flow needs GET /sanctum/csrf-cookie,
#                 which is not under /api/.
#
# The document root holds BOTH api/ (the old app's PHP endpoints) and
# api-laravel/ (the Laravel project) — see tools/build.mjs, which picks the
# api-laravel name so building Laravel cannot overwrite the old endpoints. The
# URL path /api/* therefore dispatches into api-laravel/, not api/.
# ---------------------------------------------------------------------------
RewriteEngine on

# Forward the Authorization and X-XSRF-Token headers into the request
# environment BEFORE the dispatch rules below terminate rewrite processing.
# Laravel ships these same rules in its own public/.htaccess, but [END] means
# that file's rewrite rules never run, so it has to happen here. CGI-family
# SAPIs — which is what this host and now this container use — do not hand
# Authorization to PHP otherwise. The X-XSRF-Token rule is the same
# belt-and-braces Laravel ships; it is kept so this block is a faithful
# stand-in for api/public/.htaccess, even though Apache already exports
# arbitrary request headers as HTTP_* (X-XSRF-Token reaches PHP without this
# rule) and the E= value this rule sets lands post-[END] as
# REDIRECT_HTTP_X_XSRF_TOKEN, which Symfony's ServerBag doesn't read (its
# REDIRECT_ fallback exists only for REDIRECT_HTTP_AUTHORIZATION) — so the
# rule is inert for X-XSRF-Token specifically; cookie-based Sanctum SPA CSRF
# (which GET /sanctum/csrf-cookie exists to seed) works anyway, via the
# header Apache regenerates natively.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^(api|sanctum)(/|$) - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTP:x-xsrf-token} .
RewriteRule ^(api|sanctum)(/|$) - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

# [END], not [L]. In per-directory context, a substitution is handed back to
# the URL-parsing engine as an internal redirect, and the whole ruleset runs
# again against the new path — [L] only ends the CURRENT pass, not rewrite
# processing overall. [END] stops that outright, so this dispatch is a single
# unconditional hop. That is not what defeats the front-controller catch-all
# below — REDIRECT_STATUS already does that on the second pass, per the
# REDIRECT_STATUS note in the front-controller block below — the value here
# is that correctness stops depending on REDIRECT_STATUS semantics, or on
# Laravel's own public/.htaccess re-rewriting the already-redirected
# request. Task 8's smoke script verifies this half — the dispatch surviving
# the old app's catch-all — empirically; it does not exercise the
# Authorization/X-XSRF-Token header-forwarding rules above (see that script's
# header comment for why).
RewriteRule ^api(/|$) api-laravel/public/index.php [END]
RewriteRule ^sanctum(/|$) api-laravel/public/index.php [END]
