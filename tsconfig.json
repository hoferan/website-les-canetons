{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    // `@/` -> web/src, as shadcn's CLI writes its imports. No "baseUrl": this
    // TypeScript errors on it as deprecated, and with moduleResolution
    // "bundler" a relative "paths" is resolved against this file's own
    // directory anyway. `@ds` is the design system's public barrel (ADR 0001). It must
    // agree with vite.config.ts, vitest.config.ts AND .storybook/vite.config.ts,
    // which is a separate config here and does not read vite's.
    "paths": {
      "@/*": ["./web/src/*"],
      "@ds": ["./web/src/design-system/index.ts"],
      "@ds/*": ["./web/src/design-system/*"]
    }
  },
  "include": [
    "web/src",
    "web/e2e",
    "web/screenshots",
    ".storybook",
    "orval.config.ts",
    "playwright.config.ts",
    "playwright.screenshots.config.ts"
  ]
}
